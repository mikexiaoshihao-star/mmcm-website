# Unversioned copies. The page loads the same paths with ?v=<content hash>.
/map/data/*
  Cache-Control: no-cache

/map/atlas.js
  Cache-Control: no-cache

/map/atlas.css
  Cache-Control: no-cache

/assets/style.css
  Cache-Control: no-cache

/assets/hero.js
  Cache-Control: no-cache

# Content-hashed hero derivatives. The hash is in the filename.
# Kept out of /images/home/ so the unversioned home rule cannot also apply.
/images/hero/*
  Cache-Control: public, max-age=31536000, immutable
