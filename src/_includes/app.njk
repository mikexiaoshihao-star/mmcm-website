                                <div class="flex items-center gap-4 opacity-50 group-hover:opacity-100 transition-opacity duration-300"><span class="text-[10px] text-gray-500 group-hover:text-[#111111]" x-text="client.loc"></span><span class="text-[#111111] text-xs opacity-0 group-hover:opacity-100 transition-opacity">>></span></div>
                            </div>
                        </template>
                    </div>
                    <div class="mt-8 text-[10px] text-gray-600 font-mono flex justify-end items-center gap-2"><span class="w-2 h-2 bg-[#111111] rounded-full"></span><span x-text="$store.lang.t('dbUpdated')"></span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- VIEW 4: CONTACT（从配置读取）-->
    <section x-show="currentView === 'contact'" x-cloak class="min-h-screen pt-24 md:pt-40 px-6 md:px-12 z-10 flex justify-center">
        <div class="w-full max-w-4xl">
            <div class="mb-12 font-mono text-[10px] text-[#111111] flex items-center gap-2"><span class="w-1.5 h-1.5 bg-[#111111] animate-pulse"></span><span x-text="$store.lang.t('signal')"></span></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                <div class="space-y-8">
                    <div>
                        <div class="text-[9px] text-gray-600 font-mono mb-1 uppercase tracking-widest" x-text="$store.lang.t('mobile')"></div>
                        <div class="text-xl md:text-3xl text-[#111111] font-mono" x-text="contact.phone"></div>
                    </div>
                    <div>
                        <div class="text-[9px] text-gray-600 font-mono mb-1 uppercase tracking-widest" x-text="$store.lang.t('email')"></div>
                        <a :href="'mailto:' + contact.email" class="text-xl md:text-3xl text-[#111111] font-mono hover:text-[#111111] transition-colors" x-text="contact.email"></a>
                    </div>
                    <div>
                        <div class="text-[9px] text-gray-600 font-mono mb-1 uppercase tracking-widest" x-text="$store.lang.t('site')"></div>
                        <a href="#" class="text-xl md:text-3xl text-[#111111] font-mono hover:underline decoration-[#111111] underline-offset-4 transition-all" x-text="contact.website"></a>
                    </div>
                </div>
                <div class="space-y-4">
                    <div class="text-xs text-gray-500 font-mono border-b border-black/10 pb-2 mb-4" x-text="$store.lang.t('social')"></div>
                    <template x-for="social in contact.social">
                        <div class="flex justify-between items-center py-4 border-b border-black/5 group">
                            <div class="font-mono">
                                <div class="text-[9px] text-gray-500 uppercase mb-1 group-hover:text-[#111111] transition-colors" x-text="$store.lang.code === 'zh' ? social.platformCN : social.platform"></div>
                                <div class="text-xs text-[#111111]" x-text="social.id"></div>
                            </div>
                            <span class="text-[9px] text-[#111111] opacity-0 group-hover:opacity-100 transition-opacity" x-text="$store.lang.t('linkArrow')"></span>
                        </div>
                    </template>
                </div>
            </div>
            <div class="mt-16 pt-6 border-t border-black/5 text-[9px] text-gray-600 font-mono">
                <div x-text="$store.lang.t('location') + ': ' + $store.lang.place(contact.location)"></div>
            </div>
        </div>
    </section>

    <script>
        /* Pin the visible edges of 毫 and 影 to the wordmark. Side bearings differ by face, so measure the face that actually loaded. */
        (function () {
            var line = document.querySelector('.site-logo-zh');
            if (!line) return;
            var first = line.firstElementChild;
            var last = line.lastElementChild;
            function bearing(ch) {
                var cs = getComputedStyle(line);
                var size = 200;
                var canvas = document.createElement('canvas');
                var ctx = canvas.getContext('2d');
                if (!ctx || !ctx.measureText) return null;
                ctx.font = cs.fontWeight + ' ' + size + 'px ' + cs.fontFamily;
                var metrics = ctx.measureText(ch);
                if (metrics.actualBoundingBoxLeft == null || metrics.actualBoundingBoxRight == null) return null;
                return {
                    left: -metrics.actualBoundingBoxLeft / size,
                    right: (metrics.width - metrics.actualBoundingBoxRight) / size
                };
            }
            function align() {
                var start = bearing(first.textContent);
                var end = bearing(last.textContent);
                if (!start || !end) return;
                first.style.marginLeft = (-start.left) + 'em';
                last.style.marginRight = (-end.right) + 'em';
            }
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(align);
            else align();
        })();
    </script>
</body>
