<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#ffffff">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://cdn-font.hyperos.mi.com">
    <link rel="preconnect" href="https://cdn-file.hyperos.mi.com" crossorigin>
    <link rel="stylesheet" href="https://cdn-font.hyperos.mi.com/font/css?family=MiSans:300,400,600:Chinese_Simplify,Latin&display=swap">
    <script>
        (function () {
            var mapV = "{{ mapAssetVersion }}";
            var files = ['/map/data/projects.js', '/map/data/globe.js', '/map/data/places.js', '/map/atlas.js'].map(function (href) {
                return href + '?v=' + mapV;
            });
            var run = function () {
                files.forEach(function (href) {
                    if (document.querySelector('link[data-atlas-prefetch="' + href + '"]')) return;
                    var link = document.createElement('link');
                    link.rel = 'prefetch';
                    link.as = 'script';
                    link.href = href;
                    link.setAttribute('data-atlas-prefetch', href);
                    document.head.appendChild(link);
                });
            };
            if (window.requestIdleCallback) window.requestIdleCallback(run, { timeout: 2000 });
            else window.setTimeout(run, 1);
        })();
    </script>
    {%- set ogTitle = pageTitle or "MMCM STUDIO 毫厘建筑摄影" -%}
    {%- set ogDesc = pageDesc or "MMCM STUDIO 毫厘建筑摄影 · Chengdu" -%}
    {%- set ogImage = ogImagePath or "/images/home/01.webp" %}
    <title>{{ ogTitle }}</title>
    <link rel="canonical" href="https://www.mmcm-studio.com{{ page.url }}">
    <meta name="description" content="{{ ogDesc }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="MMCM STUDIO 毫厘建筑摄影">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    <meta property="og:url" content="https://www.mmcm-studio.com{{ page.url }}">
    <meta property="og:image" content="https://www.mmcm-studio.com{{ ogImage | urlencodePath }}">
    <meta name="twitter:card" content="summary_large_image">
    <script>window.__INITIAL_PROJECT__ = {{ initialProject | js | safe }};</script>
    <script>window.__INITIAL_VIEW__ = {{ initialView | js | safe }};</script>
    <script>
        (function () {
            var onProject = /^\/projects\/[^/]+\/?$/.test(location.pathname)
                || /^#\/project\/[^/?]+/.test(location.hash)
                || !!window.__INITIAL_PROJECT__;
            var onMedia = /^\/media\/?$/.test(location.pathname)
                || /^#\/media\/?$/.test(location.hash)
                || (window.__INITIAL_VIEW__ === 'media' && /^\/media\/?$/.test(location.pathname));
            if (onProject || onMedia) document.documentElement.classList.add('route-project');
        })();
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('mmcm-lang'); } catch (e) {}
            var lang = (stored === 'zh' || stored === 'en')
                ? stored
                : ((navigator.language || '').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
            window.__MMCM_LANG = lang;
            document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['MiSans', 'PingFang SC', 'system-ui', '-apple-system', 'Helvetica Neue', 'Arial', 'sans-serif'], mono: ['MiSans', 'PingFang SC', 'system-ui', '-apple-system', 'Helvetica Neue', 'Arial', 'sans-serif'], serif: ['MiSans', 'PingFang SC', 'system-ui', '-apple-system', 'Helvetica Neue', 'Arial', 'sans-serif'] },
                    colors: { 'ink': '#111111', 'paper': '#ffffff', 'mist': '#f4f4f4', 'stone': '#6b6b6b' }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/assets/style.css?v={{ assetVersion }}">

    <script>
        const siteData = {
    categories: {{ site.categories | dump | safe }},
    homeProjects: {{ site.homeProjects | dump | safe }},
homeProjectsMobile: {{ site.homeProjectsMobile | dump | safe }},
    projects: {{ site.projects | dump | safe }},
    filmProjects: {{ site.filmProjects | dump | safe }},
filmCategories: {{ site.filmCategories | dump | safe }},
    studio: {{ site.studio | dump | safe }},
    contact: {{ site.contact | dump | safe }},
    media: {{ media | dump | safe }}
};

        document.addEventListener('alpine:init', () => {
            const ARCHITECT_ZH = {
                'Tektonn_Architects': '天仝建筑',
