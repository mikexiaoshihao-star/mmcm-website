<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#ffffff">
    {%- set ogTitle = pageTitle or "MMCM STUDIO 毫厘建筑摄影" -%}
    {%- set ogDesc = pageDesc or "MMCM STUDIO 毫厘建筑摄影 · Chengdu" -%}
    {%- set ogImage = ogImagePath or "/images/home/01.webp" %}
    <title>{{ ogTitle }}</title>
    <link rel="canonical" href="https://www.mmcm-studio.com{{ page.url }}">
    <meta name="description" content="{{ ogDesc }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="MMCM STUDIO 毫厘建筑摄影">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    <meta property="og:url" content="https://www.mmcm-studio.com{{ page.url }}">
    <meta property="og:image" content="https://www.mmcm-studio.com{{ ogImage | urlencodePath }}">
    <meta name="twitter:card" content="summary_large_image">
    <script>window.__INITIAL_PROJECT__ = {{ initialProject | js | safe }};</script>
    <script>
        (function () {
            var onProject = /^\/projects\/[^/]+\/?$/.test(location.pathname)
                || /^#\/project\/[^/?]+/.test(location.hash)
                || !!window.__INITIAL_PROJECT__;
            if (onProject) document.documentElement.classList.add('route-project');
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/style.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: { 'ink': '#111111', 'paper': '#ffffff', 'mist': '#f4f4f4', 'stone': '#6b6b6b' }
                }
            }
        }
    </script>

    <script>
        const siteData = {
    categories: {{ site.categories | dump | safe }},
    homeProjects: {{ site.homeProjects | dump | safe }},
homeProjectsMobile: {{ site.homeProjectsMobile | dump | safe }},
    projects: {{ site.projects | dump | safe }},
    filmProjects: {{ site.filmProjects | dump | safe }},
filmCategories: {{ site.filmCategories | dump | safe }},
    studio: {{ site.studio | dump | safe }},
    contact: {{ site.contact | dump | safe }}
};

        document.addEventListener('alpine:init', () => {
            Alpine.data('scrambleText', (initialText = '') => ({
                displayText: initialText, 
                chars: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ/<>[]#1234567890_@$%',
                interval: null,
                init() { if (initialText) this.animate(initialText); },
                animate(newText) {
                    const target = newText || '';
                    let iteration = 0;
                    clearInterval(this.interval);
                    this.interval = setInterval(() => {
                        this.displayText = target.split('').map((letter, index) => {
                            if(index < iteration) return target[index];
                            return this.chars[Math.floor(Math.random() * this.chars.length)];
                        }).join('');
                        if(iteration >= target.length){ clearInterval(this.interval); this.displayText = target; }
                        iteration += 1/3; 
                    }, 20); 
                }
            }));

            Alpine.data('categoryBtn', (key, name) => ({
                key: key, name: name, displayText: key,
                chars: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ/<>[]#1234567890_@$%',
                interval: null,
                init() { this.animate(this.key); },
                animate(newText) {
                    const target = newText || '';
                    let iteration = 0;
                    clearInterval(this.interval);
                    this.interval = setInterval(() => {
                        this.displayText = target.split('').map((letter, index) => {
                            if(index < iteration) return target[index];
                            return this.chars[Math.floor(Math.random() * this.chars.length)];
                        }).join('');
                        if(iteration >= target.length){ clearInterval(this.interval); this.displayText = target; }
                        iteration += 1/3; 
                    }, 20); 
                }
            }));

            const HOME_TITLE = 'MMCM STUDIO 毫厘建筑摄影';

            Alpine.data('mainApp', () => ({
                currentView: (/^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash) || window.__INITIAL_PROJECT__) ? 'project_detail' : 'home',
                activeFilter: 'ALL',
                activeFilmFilter: 'ALL',
                currentHomeIndex: 0,
                homeImgVisible: true,
                categories: siteData.categories,
               homeProjects: siteData.homeProjects,
homeProjectsMobile: siteData.homeProjectsMobile || siteData.homeProjects,
currentHomeMobileIndex: 0,
                projects: siteData.projects,
                filmProjects: siteData.filmProjects || [],
                filmCategories: siteData.filmCategories || [],
                studio: siteData.studio,
                contact: siteData.contact,
                selectedProject: null,
                linkCopied: false,
                selectedFilm: null,
                detailImages: [],
                currentDetailImageIndex: 0,
                touchStartX: 0,
                touchCurrentX: 0,
                isDragging: false,
                containerWidth: 0,
               
                get currentHomeProject() { return this.homeProjects[this.currentHomeIndex]; },
                nextHomeProject() {
    this.homeImgVisible = false;
    setTimeout(() => {
        this.currentHomeIndex = (this.currentHomeIndex + 1) % this.homeProjects.length;
        this.currentHomeMobileIndex = (this.currentHomeMobileIndex + 1) % this.homeProjectsMobile.length;
        this.homeImgVisible = true;
    }, 400);
},
get currentHomeMobileProject() { return this.homeProjectsMobile[this.currentHomeMobileIndex]; },
                slugOf(project) {
                    if (!project) return '';
                    if (project.slug) return project.slug;
                    return String(project.title || '').replace(/&/g, 'and').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
                },
                findBySlug(slug) {
                    if (!slug) return null;
                    return this.projects.find((project) => this.slugOf(project) === slug) || null;
                },
                routeFromUrl() {
                    const pathMatch = location.pathname.match(/^\/projects\/([^/]+)\/?$/);
                    const hashMatch = location.hash.match(/^#\/project\/([^/?]+)/);
                    let slug = null;
                    if (pathMatch) slug = decodeURIComponent(pathMatch[1]);
                    else if (hashMatch) slug = decodeURIComponent(hashMatch[1]);
                    else if (window.__INITIAL_PROJECT__ && /^\/projects\//.test(location.pathname)) slug = window.__INITIAL_PROJECT__;
                    const project = slug ? this.findBySlug(slug) : null;
                    if (project) {
                        this.openProject(project, { push: false });
                        return;
                    }
                    if (this.currentView === 'project_detail') {
                        this.selectedProject = null;
                        this.detailImages = [];
                        this.currentDetailImageIndex = 0;
                        this.linkCopied = false;
                        this.currentView = 'works';
                        document.title = HOME_TITLE;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                },
                init() {
                    this.routeFromUrl();
                    window.addEventListener('popstate', () => this.routeFromUrl());
                    window.addEventListener('hashchange', () => this.routeFromUrl());
                    this.$nextTick(() => document.documentElement.classList.remove('route-project'));
                },
                switchView(view) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    const leavingProject = this.currentView === 'project_detail' && view !== 'project_detail';
                    this.currentView = view;
                    if (!leavingProject) return;
                    const onProjectUrl = /^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash);
                    if (onProjectUrl) history.pushState({ view: view }, '', '/');
                    document.title = HOME_TITLE;
                    this.linkCopied = false;
                },
                openProject(project, opts = {}) {
    this.selectedProject = project;
    this.linkCopied = false;
    this.currentDetailImageIndex = 0;
    // cover 图作为第一张，然后加上 images 数组里的图
    const coverImg = project.url;
    const detailImgs = project.images || [];
    const allImgs = [coverImg, ...detailImgs];
    this.detailImages = allImgs.map((item, i) => {
        if (typeof item === 'string') {
            return {
                url: item,
                desc: i === 0 ? 'MAIN_VIEW' : 'DETAIL_' + String(i).padStart(2, '0'),
                meta: 'RAW // 24MP'
            };
        } else {
            return {
                url: item.url,
                desc: item.desc || 'DETAIL_' + String(i).padStart(2, '0'),
                meta: item.meta || 'RAW // 24MP'
            };
        }
    });
    this.switchView('project_detail');
    const slug = this.slugOf(project);
    const url = '/projects/' + slug + '/';
    if (opts.push !== false && location.pathname !== url) history.pushState({ project: slug }, '', url);
    document.title = String(project.title || '').replace(/_/g, ' ') + ' | ' + HOME_TITLE;
},
                copyProjectLink() {
                    const project = this.selectedProject;
                    if (!project) return;
                    const url = location.origin + '/projects/' + this.slugOf(project) + '/';
                    const mark = () => {
                        this.linkCopied = true;
                        clearTimeout(this._copyTimer);
                        this._copyTimer = setTimeout(() => { this.linkCopied = false; }, 1600);
                    };
                    const fallback = () => {
                        const field = document.createElement('textarea');
                        field.value = url;
                        field.setAttribute('readonly', '');
                        field.style.position = 'fixed';
                        field.style.left = '-9999px';
                        document.body.appendChild(field);
                        field.select();
                        try { document.execCommand('copy'); mark(); } catch (err) {}
                        document.body.removeChild(field);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(mark).catch(fallback);
                    } else {
                        fallback();
                    }
                },
              selectDetailImage(index) {
    this.currentDetailImageIndex = index;
},
prevDetailImage() {
    if (this.detailImages.length === 0) return;
    if (this.currentDetailImageIndex > 0) {
        this.currentDetailImageIndex--;
    }
},
nextDetailImage() {
    if (this.detailImages.length === 0) return;
    if (this.currentDetailImageIndex < this.detailImages.length - 1) {
        this.currentDetailImageIndex++;
    }
},
getSliderOffset() {
    const baseOffset = -this.currentDetailImageIndex * 100;
    if (this.isDragging && this.containerWidth > 0) {
        const dragOffset = ((this.touchCurrentX - this.touchStartX) / this.containerWidth) * 100;
        return baseOffset + dragOffset;
    }
    return baseOffset;
},
handleThumbnailWheel(e) {
    e.preventDefault();
    e.currentTarget.scrollLeft += e.deltaY;
},
handleSwipeStart(e) {
    if (this.isAnimating) return;
    this.isDragging = true;
    this.touchStartX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
    this.offsetX = 0;
},
handleSwipeMove(e) {
    if (!this.isDragging) return;
    const currentX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
    this.offsetX = currentX - this.touchStartX;
},
handleSwipeEnd() {
    if (!this.isDragging) return;
    this.isDragging = false;
    this.isAnimating = true;
    
    const threshold = 80;
    if (this.offsetX < -threshold && this.currentDetailImageIndex < this.detailImages.length - 1) {
        this.currentDetailImageIndex++;
    } else if (this.offsetX > threshold && this.currentDetailImageIndex > 0) {
        this.currentDetailImageIndex--;
    }
    
    this.offsetX = 0;
    setTimeout(() => { this.isAnimating = false; }, 300);
},
getPrevIndex() {
    return this.currentDetailImageIndex > 0 ? this.currentDetailImageIndex - 1 : null;
},
getNextIndex() {
    return this.currentDetailImageIndex < this.detailImages.length - 1 ? this.currentDetailImageIndex + 1 : null;
},
                get filteredProjects() {
    if (this.activeFilter === 'ALL') return this.projects;
    return this.projects.filter(p => p.category === this.activeFilter);
},
openFilm(film) {
    this.selectedFilm = film;
    this.switchView('film_detail');
},
closeFilm() {
    this.selectedFilm = null;
    this.switchView('film');
},
get filteredFilmProjects() {
    if (this.activeFilmFilter === 'ALL') return this.filmProjects;
    return this.filmProjects.filter(p => p.category === this.activeFilmFilter);
}
            }));
        });
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-white text-[#111111] font-sans antialiased selection:bg-[#111111] selection:text-white relative min-h-svh overflow-x-hidden flex flex-col" x-data="mainApp">

    <!-- 背景特效 -->
    <div class="fixed inset-0 z-0 pointer-events-none scanlines z-[1] opacity-100"></div>
    <div class="fixed inset-0 z-0 pointer-events-none vignette z-[2]"></div>

    <!-- 顶部导航栏 -->
    <nav class="fixed top-0 w-full z-40 h-16 md:h-20 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 px-4 md:px-12 bg-white/90 border-b border-black/10 backdrop-blur-md">
        <a href="#" @click.prevent="switchView('home')" aria-label="MMCM STUDIO 毫厘建筑摄影" class="site-logo justify-self-start min-w-0 max-w-full">
            <span class="site-logo-mark" aria-hidden="true">{% include "src/images/logo/mmcm-logo.svg" %}</span>
            <span class="site-logo-zh" lang="zh-Hans" aria-hidden="true"><span>毫</span><span>厘</span><span>建</span><span>筑</span><span>摄</span><span>影</span></span>
        </a>
        <div class="flex gap-2 md:gap-12 font-mono text-[9px] md:text-xs text-[#666666] shrink-0">
            <a href="#" @click.prevent="switchView('works')" :class="currentView === 'works' || currentView === 'project_detail' ? 'text-[#111111]' : ''" class="transition-colors" x-data="scrambleText('WORKS')" @mouseenter="animate('WORKS')" x-text="displayText">WORKS</a>
<a href="#" @click.prevent="switchView('film')" :class="currentView === 'film' || currentView === 'film_detail' ? 'text-[#111111]' : ''" class="transition-colors" x-data="scrambleText('FILM')" @mouseenter="animate('FILM')" x-text="displayText">FILM</a>
<a href="#" @click.prevent="switchView('studio')" :class="currentView === 'studio' ? 'text-[#111111]' : ''" class="transition-colors" x-data="scrambleText('STUDIO')" @mouseenter="animate('STUDIO')" x-text="displayText">STUDIO</a>
            <a href="#" @click.prevent="switchView('contact')" :class="currentView === 'contact' ? 'text-[#111111]' : ''" class="transition-colors" x-data="scrambleText('CONTACT')" @mouseenter="animate('CONTACT')" x-text="displayText">CONTACT</a>
        </div>
    </nav>

    <!-- VIEW 1: HOME -->
    <section data-view="home" x-show="currentView === 'home'" class="h-svh w-full flex flex-col pt-16 md:pt-20 pb-8 px-4 md:px-12 relative z-10">
        <div class="flex-grow w-full relative overflow-hidden bg-[#f4f4f4] border border-black/10 group cursor-pointer" @click="nextHomeProject()">
            <!-- 电脑端图片 -->
<img x-show="homeImgVisible" 
     :src="currentHomeProject.img" 
     class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-all duration-700 absolute inset-0 hidden md:block"
     x-transition:enter="transition ease-out duration-500"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-80"
     draggable="false">
<!-- 手机端图片 -->
<img x-show="homeImgVisible" 
     :src="currentHomeMobileProject.img" 
     class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-all duration-700 absolute inset-0 block md:hidden"
     x-transition:enter="transition ease-out duration-500"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-80"
     draggable="false">
        </div>
        <div class="mt-6 flex flex-col md:flex-row justify-between items-start font-mono text-[10px] md:text-xs">
    <!-- 电脑端信息 -->
    <div class="hidden md:flex flex-col gap-1 items-start mb-4 md:mb-0">
        <div class="text-gray-500 h-5 overflow-visible whitespace-nowrap" x-data="scrambleText()" x-effect="animate(currentHomeProject.architect)" x-text="displayText"></div>
        <div class="text-[#111111] font-bold text-sm md:text-xl" x-data="scrambleText()" x-effect="animate(currentHomeProject.title)" x-text="displayText"></div>
    </div>
    <!-- 手机端信息 -->
    <div class="flex md:hidden flex-col gap-1 items-start mb-4">
        <div class="text-gray-500 h-5 overflow-visible whitespace-nowrap" x-text="currentHomeMobileProject.architect"></div>
        <div class="text-[#111111] font-bold text-sm" x-text="currentHomeMobileProject.title"></div>
    </div>
    <!-- 电脑端右侧信息 -->
    <div class="hidden md:flex flex-col gap-1 items-start md:items-end mt-0">
        <div class="text-gray-500 h-5 overflow-visible whitespace-nowrap" x-data="scrambleText()" x-effect="animate(currentHomeProject.address)" x-text="displayText"></div>
        <div class="flex items-center text-[#111111] font-bold h-5 overflow-visible whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-[#111111] animate-pulse mr-2"></span>
            <span x-data="scrambleText()" x-effect="animate(currentHomeProject.coords)" x-text="displayText"></span>
        </div>
    </div>
    <!-- 手机端右侧信息 -->
    <div class="flex md:hidden flex-col gap-1 items-start mt-0">
        <div class="text-gray-500 h-5 overflow-visible whitespace-nowrap" x-text="currentHomeMobileProject.address"></div>
        <div class="flex items-center text-[#111111] font-bold h-5 overflow-visible whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-[#111111] animate-pulse mr-2"></span>
            <span x-text="currentHomeMobileProject.coords"></span>
        </div>
    </div>
</div>
    </section>

    <!-- VIEW 2: WORKS -->
    <section x-show="currentView === 'works'" x-cloak class="px-4 md:px-12 pt-24 md:pt-32 pb-20 max-w-screen-2xl mx-auto z-10 w-full min-h-screen">
        <div class="mb-10 flex flex-wrap gap-3 font-mono text-xs z-20 relative">
            <button @click="activeFilter = 'ALL'" 
                    class="relative px-3 py-2 border transition-all duration-300 group overflow-hidden"
                    :class="activeFilter === 'ALL' ? 'bg-[#111111] text-white border-[#111111] font-bold' : 'bg-transparent border-black/20 text-gray-500 hover:border-black hover:text-[#111111]'"
                    x-data="scrambleText('ALL_PROJECTS')" @mouseenter="animate('ALL_PROJECTS')">
                <span class="relative z-10 flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-sm transition-colors duration-300" :class="activeFilter === 'ALL' ? 'bg-white' : 'bg-gray-600 group-hover:bg-[#111111]'"></span>
                    <span x-text="displayText"></span>
                </span>
            </button>
           <template x-for="cat in categories" :key="cat.key">
                <button @click="activeFilter = cat.key" 
                        class="relative px-3 py-2 border transition-all duration-300 group overflow-hidden"
                        :class="activeFilter === cat.key ? 'bg-[#111111] text-white border-[#111111] font-bold' : 'bg-transparent border-black/20 text-gray-500 hover:border-black hover:text-[#111111]'"
                        x-data="categoryBtn(cat.key, cat.name)" @mouseenter="animate(key)">
                    <span class="relative z-10 flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-sm transition-colors duration-300" :class="activeFilter === key ? 'bg-white' : 'bg-gray-600 group-hover:bg-[#111111]'"></span>
                        <span x-text="displayText"></span>
                        <span class="opacity-50 text-[10px] scale-90" x-text="'// ' + name"></span>
                    </span>
                </button>
            </template>
        </div>
        <div class="columns-1 md:columns-3 gap-8">
            <template x-for="(project, index) in filteredProjects" :key="index">
                <div class="group relative cursor-pointer flex flex-col gap-3 break-inside-avoid mb-8" @click="openProject(project)">
                    <div class="relative w-full bg-[#f4f4f4] overflow-hidden border border-black/10 group-hover:border-[#111111] transition-colors duration-300">
                        <img :src="project.url" loading="lazy" class="w-full h-auto block filter grayscale group-hover:grayscale-0 transition-all duration-500">
                    </div>
                    <div class="font-mono text-[10px] flex flex-col gap-1.5 border-l border-black/10 pl-3 transition-colors duration-300 group-hover:border-[#111111]/50">
    <div class="text-[#111111] font-bold group-hover:text-[#111111] transition-colors leading-tight break-words" x-text="project.title"></div>
    <div class="flex justify-between items-baseline">
        <div class="text-[#666666]" x-text="project.architect"></div>
        <div class="text-gray-600 scale-90 flex-shrink-0 ml-2" x-text="'[ ' + project.year + ' ]'"></div>
    </div>
    <div class="flex justify-between items-center">
        <div class="flex items-center gap-2">
            <span class="bg-black/[0.06] px-1.5 py-0.5 rounded text-[9px] text-[#444444]" x-text="project.category"></span>
            <span class="w-1.5 h-1.5 bg-[#111111] rounded-full animate-pulse"></span>
            <span class="text-[#111111] text-[9px]" x-text="project.coords"></span>
        </div>
        <div class="text-gray-500 text-[9px] flex-shrink-0 ml-2" x-text="project.location"></div>
    </div>
</div>
                </div>
            </template>
        </div>
    </section>

    <!-- VIEW 2.5: PROJECT DETAIL -->
    <section x-show="currentView === 'project_detail'" x-cloak class="fixed inset-0 z-[60] bg-white flex flex-col font-mono">
        <div class="lg:hidden fixed top-0 left-0 w-full h-16 flex items-center px-4 bg-white/90 backdrop-blur-md border-b border-black/10 z-[70]">
            <button type="button" @click="switchView('works')" class="w-10 h-10 flex items-center justify-start text-[#111111] text-xl font-light hover:text-[#111111] transition-colors">《</button>
            <div class="flex-grow text-center text-[10px] text-[#666666] tracking-widest uppercase">Project Detail</div>
            <button type="button" @click="copyProjectLink()" class="h-10 min-w-10 flex items-center justify-end text-[9px] tracking-widest text-[#111111] hover:text-[#111111] transition-colors" x-text="linkCopied ? 'COPIED' : 'LINK'"></button>
        </div>
        <div class="relative flex-grow w-full bg-[#f4f4f4] overflow-hidden flex items-center justify-center pt-16 lg:pt-0 group">
            <button @click.stop="prevDetailImage()" class="absolute left-2 md:left-8 z-30 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center text-[#111111] bg-white/90 hover:bg-white border border-black/10 text-3xl font-light focus:outline-none transition-colors">〈</button>
         <div class="relative w-full h-full overflow-hidden select-none"
     @touchstart="handleSwipeStart($event)"
     @touchmove.prevent="handleSwipeMove($event)"
     @touchend="handleSwipeEnd()"
     @mousedown="handleSwipeStart($event)"
     @mousemove="handleSwipeMove($event)"
     @mouseup="handleSwipeEnd()"
     @mouseleave="handleSwipeEnd()">
    <div class="flex h-full"
         :class="isDragging ? '' : 'transition-transform duration-300 ease-out'"
         :style="'transform: translateX(' + getSliderOffset() + '%)'">
        <template x-for="(img, index) in detailImages" :key="index">
            <div class="flex-shrink-0 w-full h-full flex items-center justify-center p-4 lg:p-8">
                <img :src="img.url" 
                     class="max-w-full max-h-full object-contain border border-black/10 pointer-events-none" 
                     draggable="false">
            </div>
        </template>
    </div>
