<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#ffffff">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {%- set ogTitle = pageTitle or "MMCM STUDIO 毫厘建筑摄影" -%}
    {%- set ogDesc = pageDesc or "MMCM STUDIO 毫厘建筑摄影 · Chengdu" -%}
    {%- set ogImage = ogImagePath or "/images/home/01.webp" %}
    <title>{{ ogTitle }}</title>
    <link rel="canonical" href="https://www.mmcm-studio.com{{ page.url }}">
    <meta name="description" content="{{ ogDesc }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="MMCM STUDIO 毫厘建筑摄影">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    <meta property="og:url" content="https://www.mmcm-studio.com{{ page.url }}">
    <meta property="og:image" content="https://www.mmcm-studio.com{{ ogImage | urlencodePath }}">
    <meta name="twitter:card" content="summary_large_image">
    <script>window.__INITIAL_PROJECT__ = {{ initialProject | js | safe }};</script>
    <script>window.__INITIAL_VIEW__ = {{ initialView | js | safe }};</script>
    <script>
        (function () {
            var onProject = /^\/projects\/[^/]+\/?$/.test(location.pathname)
                || /^#\/project\/[^/?]+/.test(location.hash)
                || !!window.__INITIAL_PROJECT__;
            var onMedia = /^\/media\/?$/.test(location.pathname)
                || /^#\/media\/?$/.test(location.hash)
                || (window.__INITIAL_VIEW__ === 'media' && /^\/media\/?$/.test(location.pathname));
            if (onProject || onMedia) document.documentElement.classList.add('route-project');
        })();
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('mmcm-lang'); } catch (e) {}
            var lang = (stored === 'zh' || stored === 'en')
                ? stored
                : ((navigator.language || '').toLowerCase().indexOf('zh') === 0 ? 'zh' : 'en');
            window.__MMCM_LANG = lang;
            document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
            window.__MMCM_LOAD_ZH_FONT = function () {
                if (document.getElementById('misans-css')) return;
                var link = document.createElement('link');
                link.id = 'misans-css';
                link.rel = 'stylesheet';
                link.href = 'https://cdn-font.hyperos.mi.com/font/css?family=MiSans:300,400:Chinese_Simplify,Latin&display=swap';
                document.head.appendChild(link);
            };
            if (lang === 'zh') window.__MMCM_LOAD_ZH_FONT();
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@200;300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/style.css?v={{ assetVersion }}">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], mono: ['JetBrains Mono', 'monospace'] },
                    colors: { 'ink': '#111111', 'paper': '#ffffff', 'mist': '#f4f4f4', 'stone': '#6b6b6b' }
                }
            }
        }
    </script>

    <script>
        const siteData = {
    categories: {{ site.categories | dump | safe }},
    homeProjects: {{ site.homeProjects | dump | safe }},
homeProjectsMobile: {{ site.homeProjectsMobile | dump | safe }},
    projects: {{ site.projects | dump | safe }},
    filmProjects: {{ site.filmProjects | dump | safe }},
filmCategories: {{ site.filmCategories | dump | safe }},
    studio: {{ site.studio | dump | safe }},
    contact: {{ site.contact | dump | safe }},
    media: {{ media | dump | safe }}
};

        document.addEventListener('alpine:init', () => {
            const ARCHITECT_ZH = {
                'Tektonn_Architects': '天仝建筑',
                'Tanghua_Architects_&_Associates': '汤桦建筑',
                'Tanghua_Architects&Associates': '汤桦建筑',
                'Tanghua_Architects_&_Associates / BIAD': '汤桦建筑 / 北京建筑设计研究院',
                'SADI': '四川省建筑设计研究院',
                'Luxelakes': '麓湖',
                'Gianni_Botsford_Architects': 'Gianni Botsford Architects',
                'Sybarite': 'Sybarite',
                'SCDA': 'SCDA',
                'Aecom': 'AECOM',
                'J&A': 'J&A',
                'gad': 'gad',
                'SewDesign': '纫合设计',
                'Jin_FX': 'Jin FX'
            };
            const LOCATION_ZH = {
                'Luzhou_Sichuan': '四川泸州',
                'Chengdu_Sichuan': '四川成都',
                'Chengdu,Sichuan': '四川成都',
                'Zigong_Sichuan': '四川自贡',
                'Yibin_Sichuan': '四川宜宾',
                "Xi'an_Shaanxi": '陕西西安',
                "Xi'an,Shaanxi": '陕西西安',
                'Shenzhen_Guangdong': '广东深圳',
                'Shenzhen,Guangdong': '广东深圳',
                'Ningbo_Zhejiang': '浙江宁波',
                'Xichang_Sichuan': '四川西昌',
                'Xichang, Sichuan': '四川西昌',
                'Yunyang_Chongqing': '重庆云阳',
                'Yunyang': '重庆云阳',
                'Guangyang_Bay,Chongqing': '重庆广阳湾',
                'Chongqing': '重庆',
                'Shanghai': '上海',
                'Beijing': '北京',
                'Wuhan': '湖北武汉',
                'Wuhan,Hubei': '湖北武汉',
                'CHENGDU / SICHUAN': '四川成都'
            };
            const UI = {
                en: {
                    navWorks: 'WORKS', navFilm: 'FILM', navMedia: 'MEDIA', navStudio: 'STUDIO', navContact: 'CONTACT',
                    architecture: 'Architecture', interior: 'Interior', landscape: 'Landscape',
                    comingSoon: 'Projects coming soon.', allFilms: 'ALL_FILMS',
                    filterAll: 'All',
                    type_office: 'Office', type_commercial: 'Commercial', type_residential: 'Residential',
                    type_cultural: 'Cultural', type_education: 'Education', type_sports: 'Sports',
                    type_exhibition: 'Exhibition', type_public: 'Public', type_hospitality: 'Hospitality',
                    type_mixed_use: 'Mixed-use',
                    projectDetail: 'Project Detail', link: 'LINK', copied: 'COPIED', copyLink: 'COPY LINK',
                    returnGrid: 'RETURN TO GRID', filmPlayer: 'Film Player',
                    videoUnsupported: '您的浏览器不支持视频播放',
                    interview: 'INTERVIEW', photographer: '01 // PHOTOGRAPHER', theStudio: '02 // THE STUDIO', client: '03 // CLIENT',
                    dbUpdated: 'DATABASE_LAST_UPDATED: 2026.01.07', signal: 'SIGNAL_STABLE',
                    mobile: 'Mobile / Wechat', email: 'Email Address', site: 'Official Site', social: '02 // SOCIAL_MATRIX',
                    location: 'LOCATION_DATA', linkArrow: '>> LINK',
                    architect: 'ARCHITECT', year: 'YEAR', type: 'TYPE', discipline: 'DISCIPLINE', coordinates: 'COORDINATES', images: 'IMAGES', locField: 'LOCATION',
                    returnMap: 'RETURN TO MAP',
                    mediaPage: 'Media', typeWechat: 'WECHAT', typeMagazine: 'MAGAZINE', typeFirm: 'FIRM', typeAward: 'AWARD', typeWebsite: 'WEBSITE'
                },
                zh: {
                    navWorks: '作品', navFilm: '影片', navMedia: '媒体', navStudio: '工作室', navContact: '联系',
                    architecture: '建筑', interior: '室内', landscape: '景观',
                    comingSoon: '作品上传中', allFilms: '全部影片',
                    filterAll: '全部',
                    type_office: '办公', type_commercial: '商业', type_residential: '住宅',
                    type_cultural: '文化', type_education: '教育', type_sports: '体育',
                    type_exhibition: '展览', type_public: '公共', type_hospitality: '酒店',
                    type_mixed_use: '综合体',
                    projectDetail: '项目', link: '链接', copied: '已复制', copyLink: '复制链接',
                    returnGrid: '返回列表', filmPlayer: '影片',
                    videoUnsupported: '您的浏览器不支持视频播放',
                    interview: '专访', photographer: '01 // 摄影师', theStudio: '02 // 工作室', client: '03 // 客户',
                    dbUpdated: '数据更新：2026.01.07', signal: '信号稳定',
                    mobile: '手机/微信', email: '电子邮箱', site: '官方网站', social: '02 // 社交',
                    location: '所在地', linkArrow: '>> 链接',
                    architect: '建筑设计', year: '年份', type: '类型', discipline: '门类', coordinates: '坐标', images: '图片', locField: '地点',
                    returnMap: '返回地图',
                    mediaPage: '媒体', typeWechat: '公众号', typeMagazine: '杂志', typeFirm: '设计公司', typeAward: '奖项', typeWebsite: '网站'
                }
            };
            Alpine.store('lang', {
                code: window.__MMCM_LANG === 'zh' ? 'zh' : 'en',
                t(key) { return (UI[this.code] && UI[this.code][key]) || UI.en[key] || key; },
                plain(text) {
                    return String(text == null ? '' : text).replace(/_/g, ' ');
                },
                name(item) {
                    if (!item) return '';
                    if (this.code === 'zh' && item.title_zh) return item.title_zh;
                    const en = item.title_en || item.title || '';
                    return this.code === 'zh' ? this.plain(en) : en;
                },
                personName(studio) {
                    if (!studio) return '';
                    if (this.code === 'zh' && studio.name_zh) return studio.name_zh;
                    return studio.name || '';
                },
                personTitle(studio) {
                    if (!studio) return '';
                    if (this.code === 'zh' && studio.title_zh) return studio.title_zh;
                    return studio.title || '';
                },
                architect(item) {
                    if (!item) return '';
                    const en = item.architect || item.name || '';
                    if (this.code !== 'zh') return en;
                    if (item.architect_zh) return item.architect_zh;
                    return ARCHITECT_ZH[en] || this.plain(en);
                },
                place(value) {
                    const en = value == null ? '' : String(value);
                    if (this.code !== 'zh') return en;
                    return LOCATION_ZH[en] || this.plain(en);
                },
                set(code) {
                    if (code !== 'zh' && code !== 'en') return;
                    this.code = code;
                    try { localStorage.setItem('mmcm-lang', code); } catch (e) {}
                    document.documentElement.lang = code === 'zh' ? 'zh-CN' : 'en';
                    if (code === 'zh' && window.__MMCM_LOAD_ZH_FONT) window.__MMCM_LOAD_ZH_FONT();
                }
            });
            const HOME_TITLE = 'MMCM STUDIO 毫厘建筑摄影';

            Alpine.data('mainApp', () => ({
                currentView: (/^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash) || (window.__INITIAL_PROJECT__ && /^\/projects\//.test(location.pathname))) ? 'project_detail' : ((/^\/media\/?$/.test(location.pathname) || /^#\/media\/?$/.test(location.hash) || (window.__INITIAL_VIEW__ === 'media' && /^\/media\/?$/.test(location.pathname))) ? 'media' : (/^#\/film\/?$/.test(location.hash) ? 'film' : (new URLSearchParams(location.search).get('view') === 'map' ? 'works' : 'home'))),
                /* 'from-map': the info column is only used when a project is opened from ATLAS. 'always': every project page uses it. */
                atlasProjectLayout: 'always',
                worksView: new URLSearchParams(location.search).get('view') === 'map' ? 'map' : 'grid',
                openedFromMap: false,
                worksEntry: 'architecture',
                worksType: 'all',
                worksFilterOpen: false,
                filmFilterOpen: false,
                activeFilmFilter: (function () {
                    if (!/^#\/film\/?$/.test(location.hash)) return 'ALL';
                    const raw = new URLSearchParams(location.search).get('type');
                    const key = String(raw || '').trim().toLowerCase();
                    if (!key || key === 'all') return 'ALL';
                    const cat = (siteData.filmCategories || []).find((item) => String(item.key).toLowerCase() === key);
                    return cat ? cat.key : 'ALL';
                })(),
                currentHomeIndex: 0,
                homeImgVisible: true,
                categories: siteData.categories,
               homeProjects: siteData.homeProjects,
homeProjectsMobile: siteData.homeProjectsMobile || siteData.homeProjects,
currentHomeMobileIndex: 0,
                projects: siteData.projects,
                filmProjects: siteData.filmProjects || [],
                filmCategories: siteData.filmCategories || [],
                studio: siteData.studio,
                contact: siteData.contact,
                mediaItems: siteData.media || [],
                selectedProject: null,
                linkCopied: false,
                selectedFilm: null,
                detailImages: [],
                currentDetailImageIndex: 0,
                touchStartX: 0,
                touchCurrentX: 0,
                isDragging: false,
                containerWidth: 0,
               
                get currentHomeProject() { return this.homeProjects[this.currentHomeIndex]; },
                nextHomeProject() {
    this.homeImgVisible = false;
    setTimeout(() => {
        this.currentHomeIndex = (this.currentHomeIndex + 1) % this.homeProjects.length;
        this.currentHomeMobileIndex = (this.currentHomeMobileIndex + 1) % this.homeProjectsMobile.length;
        this.homeImgVisible = true;
    }, 400);
},
get currentHomeMobileProject() { return this.homeProjectsMobile[this.currentHomeMobileIndex]; },
                slugOf(project) {
                    if (!project) return '';
                    if (project.slug) return project.slug;
                    return String(project.title || '').replace(/&/g, 'and').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
                },
                findBySlug(slug) {
                    if (!slug) return null;
                    return this.projects.find((project) => this.slugOf(project) === slug) || null;
                },
                onMediaUrl() {
                    return /^\/media\/?$/.test(location.pathname) || /^#\/media\/?$/.test(location.hash);
                },
                onFilmUrl() {
                    return /^#\/film\/?$/.test(location.hash);
                },
                routeFromUrl() {
                    const pathMatch = location.pathname.match(/^\/projects\/([^/]+)\/?$/);
                    const hashMatch = location.hash.match(/^#\/project\/([^/?]+)/);
                    let slug = null;
                    if (pathMatch) slug = decodeURIComponent(pathMatch[1]);
                    else if (hashMatch) slug = decodeURIComponent(hashMatch[1]);
                    else if (window.__INITIAL_PROJECT__ && /^\/projects\//.test(location.pathname)) slug = window.__INITIAL_PROJECT__;
                    const project = slug ? this.findBySlug(slug) : null;
                    if (project) {
                        this.openProject(project, { push: false, fromMap: !!(history.state && history.state.atlasProject) });
                        this.applyTypeFromUrl();
                        return;
                    }
                    if (this.onMediaUrl()) {
                        this.currentView = 'media';
                        document.title = Alpine.store('lang').t('mediaPage') + ' | ' + HOME_TITLE;
                        this.applyTypeFromUrl();
                        return;
                    }
                    if (this.onFilmUrl()) {
                        if (this.currentView === 'project_detail') {
                            this.selectedProject = null;
                            this.detailImages = [];
                            this.currentDetailImageIndex = 0;
                            this.linkCopied = false;
                        }
                        this.selectedFilm = null;
                        this.applyFilmFromUrl();
                        return;
                    }
                    if (this.currentView === 'film' || this.currentView === 'film_detail') {
                        this.selectedFilm = null;
                        this.filmFilterOpen = false;
                        this.activeFilmFilter = 'ALL';
                        this.currentView = 'home';
                        document.title = HOME_TITLE;
                    }
                    if (this.currentView === 'project_detail') {
                        this.selectedProject = null;
                        this.detailImages = [];
                        this.currentDetailImageIndex = 0;
                        this.linkCopied = false;
                        this.openedFromMap = false;
                        this.currentView = 'works';
                        document.title = HOME_TITLE;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else if (this.currentView === 'media') {
                        this.currentView = 'home';
                        document.title = HOME_TITLE;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                    if (this.applyTypeFromUrl()) document.title = HOME_TITLE;
                    this.applyViewFromUrl();
                },
                init() {
                    this.routeFromUrl();
                    window.addEventListener('popstate', () => this.routeFromUrl());
                    window.addEventListener('hashchange', () => this.routeFromUrl());
                    this.$nextTick(() => document.documentElement.classList.remove('route-project'));
                },
                switchView(view) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    const atlasOpen = !!(window.MMCM_ATLAS && window.MMCM_ATLAS.pageOpen && window.MMCM_ATLAS.pageOpen());
                    if (atlasOpen) window.MMCM_ATLAS.closePage();
                    const leavingProject = this.currentView === 'project_detail' && view !== 'project_detail';
                    const leavingMedia = this.currentView === 'media' && view !== 'media';
                    const leavingFilm = (this.currentView === 'film' || this.currentView === 'film_detail') && view !== 'film' && view !== 'film_detail';
                    const enteringFilm = (view === 'film' || view === 'film_detail') && !this.onFilmUrl();
                    this.currentView = view;
                    const onProjectUrl = /^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash);
                    if ((leavingProject && onProjectUrl) || (atlasOpen && onProjectUrl) || (leavingMedia && this.onMediaUrl()) || (leavingFilm && this.onFilmUrl()) || enteringFilm) {
                        const next = new URL('/', location.origin);
                        if (view === 'works' && this.worksView === 'map') next.searchParams.set('view', 'map');
                        if (view === 'works' && this.worksType && this.worksType !== 'all') next.searchParams.set('type', this.worksType);
                        if (view === 'film' || view === 'film_detail') {
                            next.hash = '/film';
                            if (this.activeFilmFilter && this.activeFilmFilter !== 'ALL') next.searchParams.set('type', this.filmSlug(this.activeFilmFilter));
                        }
                        const dest = next.pathname + next.search + next.hash;
                        const cur = location.pathname + location.search + location.hash;
                        if (dest !== cur) history.pushState({ view: view }, '', dest);
                    }
                    if (!leavingProject && !leavingMedia) return;
                    document.title = HOME_TITLE;
                    this.linkCopied = false;
                },
                openMedia() {
                    const leavingProject = this.currentView === 'project_detail';
                    this.currentView = 'media';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    if (leavingProject) {
                        this.selectedProject = null;
                        this.detailImages = [];
                        this.currentDetailImageIndex = 0;
                        this.linkCopied = false;
                    }
                    document.title = Alpine.store('lang').t('mediaPage') + ' | ' + HOME_TITLE;
                    if (!/^\/media\/?$/.test(location.pathname)) history.pushState({ view: 'media' }, '', '/media/');
                },
                mediaCover(cover) {
                    if (!cover) return '';
                    const file = String(cover).split('/').pop();
                    return '/images/media/' + file;
                },
                mediaTypeLabel(type) {
                    const raw = String(type || '').trim();
                    const value = raw.toLowerCase();
                    const t = Alpine.store('lang').t.bind(Alpine.store('lang'));
                    if (raw.includes('公众号')) return t('typeWechat');
                    if (value === 'magazine' || raw.includes('杂志')) return t('typeMagazine');
                    if (value.includes('firm') || raw.includes('设计公司')) return t('typeFirm');
                    if (value.includes('award') || raw.includes('奖项')) return t('typeAward');
                    if (value === 'website' || value === 'media' || raw.includes('网站')) return t('typeWebsite');
                    return raw;
                },
                categoryLabel(key) {
                    const zh = Alpine.store('lang').code === 'zh';
                    const cat = (this.categories || []).concat(this.filmCategories || []).find((item) => item.key === key);
                    if (!cat) return key || '';
                    return zh ? cat.name : cat.key;
                },
                applyDocumentTitle() {
                    const lang = Alpine.store('lang');
                    if (this.currentView === 'project_detail' && this.selectedProject) {
                        document.title = String(lang.name(this.selectedProject) || '').replace(/_/g, ' ') + ' | ' + HOME_TITLE;
                    } else if (this.currentView === 'media') {
                        document.title = lang.t('mediaPage') + ' | ' + HOME_TITLE;
                    } else {
                        document.title = HOME_TITLE;
                    }
                },
                mediaSortKey(item) {
                    if (item && item.date) return String(item.date);
                    if (item && item.year) return String(item.year).padStart(4, '0') + '-00-00';
                    return '';
                },
                mediaCleanLabel(text) {
                    return String(text || '')
                        .replace(/（[^）]*不在site\.json[^）]*）/g, '')
                        .replace(/\([^)]*不在site\.json[^)]*\)/g, '')
                        .replace(/\([^)]*个人摄影[^)]*\)/g, '')
                        .trim();
                },
                mediaGroupKey(item) {
                    const byTitle = {
                        'OPPO_Technology_&_Research_Center_Tower': 'OPPO科技研究中心大厦',
                        'Chengdu_SKP': '成都SKP',
                        'LuxeLakes_Kindergarten_(North_Campus)': '四川天府新区麓湖幼儿园（北区）',
                        'Xichang_Jianchuan_Museum_Documentary_Hall': '西昌建川电影博物馆聚落·纪录片陈列馆',
                        'LuxeLakes_Cloud_Kindergarten': '麓湖云朵幼儿园',
                        'Ningbo_International_Conference_Center': '宁波国际会议中心',
                        'Xinglong_Lake_Roadshow_Center': '兴隆湖天府路演艺术中心',
                        'Yibin_MixC': '宜宾万象汇',
                        'Shanghai_Poly_Opus_One': '保利世博天悦'
                    };
                    if (byTitle[item.project_en]) return byTitle[item.project_en];
                    return this.mediaCleanLabel(item.project_cn) || item.project_cn;
                },
                mediaDisplayEn(en) {
                    const cleaned = this.mediaCleanLabel(en);
                    if (!cleaned) return '';
                    if (cleaned.indexOf('_') !== -1) return cleaned.replace(/_/g, ' ');
                    return cleaned;
                },
                get mediaFeatured() {
                    return this.mediaItems.find((item) => item.slug === 'archiposition-interview') || null;
                },
                get mediaGroups() {
                    const groups = new Map();
                    const items = this.mediaItems.slice().sort((a, b) => this.mediaSortKey(b).localeCompare(this.mediaSortKey(a)));
                    items.forEach((item) => {
                        if (item.slug === 'archiposition-interview') return;
                        const key = this.mediaGroupKey(item);
                        if (!groups.has(key)) {
                            groups.set(key, {
                                project_cn: key,
                                project_en: '',
                                cover: null,
                                latest: '',
                                items: []
                            });
                        }
                        const group = groups.get(key);
                        group.items.push(item);
                        const sortKey = this.mediaSortKey(item);
                        if (sortKey > group.latest) group.latest = sortKey;
                        if (!group.cover && item.cover) group.cover = item.cover;
                    });
                    groups.forEach((group) => {
                        const prose = group.items.find((item) => item.project_en && item.project_en.indexOf('_') === -1 && !/不在site\.json|个人摄影/.test(item.project_en));
                        if (prose) {
                            group.project_cn = prose.project_cn;
                            group.project_en = prose.project_en;
                        } else {
                            const item = group.items[0];
                            group.project_cn = this.mediaCleanLabel(item.project_cn) || group.project_cn;
                            group.project_en = this.mediaDisplayEn(item.project_en);
                        }
                    });
                    return Array.from(groups.values()).sort((a, b) => String(b.latest).localeCompare(String(a.latest)));
                },
                syncTypeParam() {
                    if (this.onFilmUrl() || this.currentView === 'film' || this.currentView === 'film_detail') return;
                    if (/^\/projects\//.test(location.pathname)) return;
                    const url = new URL(location.href);
                    if (!this.worksType || this.worksType === 'all') url.searchParams.delete('type');
                    else url.searchParams.set('type', this.worksType);
                    if (this.worksView === 'map') url.searchParams.set('view', 'map');
                    else url.searchParams.delete('view');
                    const next = url.pathname + url.search + url.hash;
                    const cur = location.pathname + location.search + location.hash;
                    if (next !== cur) history.replaceState(history.state, '', next);
                },
                applyTypeFromUrl() {
                    if (this.onFilmUrl()) return false;
                    const raw = new URLSearchParams(location.search).get('type');
                    if (!raw) return false;
                    const key = String(raw).trim().toLowerCase();
                    if (!key || key === 'all') return false;
                    const matches = this.projects.filter((p) => p.type === key);
                    if (!matches.length) return false;
                    const discipline = ['architecture', 'interior', 'landscape'].find((d) => matches.some((p) => p.discipline === d));
                    if (!discipline) return false;
                    this.worksEntry = discipline;
                    this.worksType = key;
                    this.worksFilterOpen = false;
                    const onProject = this.currentView === 'project_detail';
                    const onMedia = this.currentView === 'media' || this.onMediaUrl();
                    if (!onProject && !onMedia) this.currentView = 'works';
                    return true;
                },
                setWorksType(key) {
                    this.worksType = key;
                    this.worksFilterOpen = false;
                    this.syncTypeParam();
                    this.syncAtlas();
                },
                openWorks() {
                    if (window.MMCM_ATLAS && window.MMCM_ATLAS.pageOpen && window.MMCM_ATLAS.pageOpen()) window.MMCM_ATLAS.closePage();
                    this.worksEntry = 'architecture';
                    this.worksType = 'all';
                    this.worksView = 'grid';
                    this.worksFilterOpen = false;
                    this.switchView('works');
                    this.syncTypeParam();
                    if (window.MMCM_ATLAS) window.MMCM_ATLAS.hide();
                },
                setWorksEntry(key) {
                    if (this.worksEntry !== key) {
                        this.worksEntry = key;
                        this.worksType = 'all';
                        this.syncTypeParam();
                    }
                    this.worksFilterOpen = false;
                    this.syncAtlas();
                },
                applyViewFromUrl() {
                    if (new URLSearchParams(location.search).get('view') !== 'map') return;
                    if (/^\/projects\//.test(location.pathname) || this.onMediaUrl() || this.onFilmUrl()) return;
                    this.currentView = 'works';
                    this.worksView = 'map';
                    this.$nextTick(() => this.ensureAtlas());
                },
                closeProject() {
                    const backToMap = this.openedFromMap;
                    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const fly = backToMap && this.currentDetailImageIndex === 0 && this.atlasFlight && !reduce;
                    const hero = document.querySelector('.project-stage .is-first');
                    const from = hero ? hero.getBoundingClientRect() : null;
                    let clone = null;
                    if (fly && from && from.width) {
                        clone = document.createElement('img');
                        clone.src = hero.currentSrc || hero.src;
                        clone.alt = '';
                        clone.setAttribute('data-atlas-flight', '');
                        clone.style.cssText = 'position:fixed;z-index:70;pointer-events:none;object-fit:contain;transform-origin:0 0;will-change:transform;left:' + from.x + 'px;top:' + from.y + 'px;width:' + from.width + 'px;height:' + from.height + 'px;';
                        document.body.appendChild(clone);
                    } else if (backToMap) {
                        const sheet = document.querySelector('.project-sheet');
                        if (sheet) sheet.animate([{ opacity: 1 }, { opacity: 0 }], { duration: reduce ? 180 : 320, easing: 'ease-out', fill: 'none' });
                    }
                    this.openedFromMap = false;
                    if (backToMap) this.worksView = 'map';
                    this.switchView('works');
                    this.syncTypeParam();
                    const flight = this.atlasFlight;
                    this.atlasFlight = null;
                    if (backToMap) this.$nextTick(() => this.ensureAtlas());
                    if (!clone) return;
                    const land = () => {
                        const card = document.querySelector('.b-card.on img');
                        const to = card && card.getBoundingClientRect().width ? card.getBoundingClientRect() : flight;
                        if (window.MMCM_ATLAS && window.MMCM_ATLAS.showCardImage) window.MMCM_ATLAS.showCardImage();
                        if (!to || !to.width) { clone.remove(); return; }
                        const scale = to.width / from.width;
                        clone.animate([
                            { transform: 'none' },
                            { transform: 'translate(' + (to.x - from.x) + 'px,' + (to.y - from.y) + 'px) scale(' + scale + ')' }
                        ], { duration: 800, delay: 80, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'both' }).finished.then(() => clone.remove());
                    };
                    requestAnimationFrame(() => requestAnimationFrame(land));
                },
                playAtlasFlightIn() {
                    const from = this.atlasFlight;
                    if (!from || !from.w) return;
                    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    const hero = document.querySelector('.project-stage .is-first');
                    const chrome = [...document.querySelectorAll('.project-info, .project-thumbs, .project-stage > button')];
                    if (!hero) return;
                    if (reduce) {
                        chrome.forEach((el) => {
                            const anim = el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 180, fill: 'both' });
                            anim.finished.then(() => anim.cancel()).catch(() => {});
                        });
                        if (window.MMCM_ATLAS && window.MMCM_ATLAS.showCardImage) window.MMCM_ATLAS.showCardImage();
                        return;
                    }
                    chrome.forEach((el, i) => {
                        const anim = el.animate([
                            { opacity: 0, transform: 'translateY(6px)' },
                            { opacity: 1, transform: 'none' }
                        ], { duration: 420, delay: 720 + i * 40, easing: 'ease-out', fill: 'both' });
                        anim.finished.then(() => anim.cancel()).catch(() => {});
                    });
                    hero.style.visibility = 'hidden';
                    const go = (tries) => {
                        const target = hero.getBoundingClientRect();
                        if ((!target.width || !target.height) && tries < 8) {
                            requestAnimationFrame(() => go(tries + 1));
                            return;
                        }
                        const clone = document.createElement('img');
                        clone.src = from.src || hero.currentSrc || hero.src;
                        clone.alt = '';
                        clone.setAttribute('data-atlas-flight', '');
                        clone.style.cssText = 'position:fixed;z-index:70;pointer-events:none;object-fit:contain;transform-origin:0 0;will-change:transform;left:' + target.x + 'px;top:' + target.y + 'px;width:' + target.width + 'px;height:' + target.height + 'px;';
                        document.body.appendChild(clone);
                        const scale = from.w / target.width;
                        const anim = clone.animate([
                            { transform: 'translate(' + (from.x - target.x) + 'px,' + (from.y - target.y) + 'px) scale(' + scale + ')' },
                            { transform: 'none' }
                        ], { duration: 950, easing: 'cubic-bezier(.76,0,.18,1)', fill: 'both' });
                        anim.finished.then(() => {
                            hero.style.visibility = '';
                            clone.remove();
                            if (window.MMCM_ATLAS && window.MMCM_ATLAS.showCardImage) window.MMCM_ATLAS.showCardImage();
                        });
                    };
                    requestAnimationFrame(() => go(0));
                },
                setWorksView(view) {
                    this.currentView = 'works';
                    this.worksView = view === 'map' ? 'map' : 'grid';
                    this.syncTypeParam();
                    if (this.worksView === 'map') this.$nextTick(() => this.ensureAtlas());
                    else if (window.MMCM_ATLAS) window.MMCM_ATLAS.hide();
                },
                syncAtlas() {
                    if (this.worksView !== 'map' || !window.MMCM_ATLAS) return;
                    window.MMCM_ATLAS.sync({ disc: this.worksEntry, type: this.worksType });
                },
                ensureAtlas() {
                    const lang = () => Alpine.store('lang');
                    window.MMCM_I18N = {
                        lang: () => lang().code,
                        name: (p) => lang().name({ title: p.title, title_zh: p.zh }),
                        architect: (p) => lang().architect({ architect: p.architect }),
                        place: (loc) => lang().place(loc),
                        cat: (p) => lang().code === 'zh' ? p.catZh : p.cat,
                        disc: (d) => lang().t(d)
                    };
                    window.MMCM_HOST = {
                        setDisc: (d) => { this.setWorksEntry(d); },
                        openFromAtlas: (slug, flight) => {
                            const project = this.projects.find((item) => this.slugOf(item) === slug);
                            if (!project) return;
                            this.openProject(project, { fromMap: true, flight: flight });
                        }
                    };
                    const boot = () => {
                        const root = document.getElementById('atlas-root');
                        window.MMCM_ATLAS.boot(root, { disc: this.worksEntry, type: this.worksType });
                        window.MMCM_ATLAS.show();
                    };
                    if (window.MMCM_ATLAS) { boot(); return; }
                    if (this._atlasLoading) return;
                    this._atlasLoading = true;
                    if (!document.getElementById('atlas-css')) {
                        const link = document.createElement('link');
                        link.id = 'atlas-css';
                        link.rel = 'stylesheet';
                        link.href = '/map/atlas.css';
                        document.head.appendChild(link);
                    }
                    const load = (src) => new Promise((resolve, reject) => {
                        const s = document.createElement('script');
                        s.src = src;
                        s.onload = resolve;
                        s.onerror = reject;
                        document.body.appendChild(s);
                    });
                    load('/map/data/projects.js')
                        .then(() => load('/map/data/places.js'))
                        .then(() => load('/map/data/globe.js'))
                        .then(() => load('/map/atlas.js'))
                        .then(() => { this._atlasLoading = false; boot(); })
                        .catch((err) => { this._atlasLoading = false; console.error(err); });
                },
                filmSlug(key) {
                    return String(key || '').trim().toLowerCase();
                },
                filmKeyFromSlug(slug) {
                    const key = this.filmSlug(slug);
                    if (!key || key === 'all') return 'ALL';
                    const cat = (this.filmCategories || []).find((item) => this.filmSlug(item.key) === key);
                    return cat ? cat.key : null;
                },
                applyFilmFromUrl() {
                    const raw = new URLSearchParams(location.search).get('type');
                    const key = this.filmKeyFromSlug(raw);
                    this.activeFilmFilter = key || 'ALL';
                    this.filmFilterOpen = false;
                    this.currentView = 'film';
                    document.title = HOME_TITLE;
                    return true;
                },
                setFilmType(key) {
                    this.activeFilmFilter = key || 'ALL';
                    this.filmFilterOpen = false;
                    const url = new URL('/', location.origin);
                    url.hash = '/film';
                    if (this.activeFilmFilter !== 'ALL') url.searchParams.set('type', this.filmSlug(this.activeFilmFilter));
                    const next = url.pathname + url.search + url.hash;
                    const cur = location.pathname + location.search + location.hash;
                    if (next !== cur) history.replaceState({ view: 'film' }, '', next);
                },
                openFilmIndex() {
                    this.activeFilmFilter = 'ALL';
                    this.filmFilterOpen = false;
                    this.selectedFilm = null;
                    const keep = this.onFilmUrl() && location.pathname === '/';
                    this.switchView('film');
                    if (keep) {
                        const next = '/#/film';
                        const cur = location.pathname + location.search + location.hash;
                        if (cur !== next) history.replaceState({ view: 'film' }, '', next);
                    }
                },
                filmButtonLabel(code) {
                    const films = this.filmProjects || [];
                    if (this.activeFilmFilter === 'ALL') return Alpine.store('lang').t('allFilms') + ' ' + films.length;
                    const cat = (this.filmCategories || []).find((item) => item.key === this.activeFilmFilter);
                    const label = cat ? (code === 'zh' ? cat.name : cat.key) : this.activeFilmFilter;
                    const count = films.filter((item) => item.category === this.activeFilmFilter).length;
                    return label + ' ' + count;
                },
                get projectUsesInfoColumn() {
                    return this.atlasProjectLayout === 'always' || (this.atlasProjectLayout === 'from-map' && this.openedFromMap);
                },
                openProject(project, opts = {}) {
    this.openedFromMap = !!opts.fromMap;
    if (project && project.discipline && project.discipline !== this.worksEntry) {
        this.worksEntry = project.discipline;
        this.worksType = 'all';
    }
    this.worksFilterOpen = false;
    this.selectedProject = project;
    this.linkCopied = false;
    this.currentDetailImageIndex = 0;
    // cover 图作为第一张，然后加上 images 数组里的图
    const coverImg = project.url;
    const detailImgs = project.images || [];
    const allImgs = [coverImg, ...detailImgs];
    this.detailImages = allImgs.map((item, i) => {
        if (typeof item === 'string') {
            return {
                url: item,
                desc: i === 0 ? 'MAIN_VIEW' : 'DETAIL_' + String(i).padStart(2, '0'),
                meta: 'RAW // 24MP'
            };
        } else {
            return {
                url: item.url,
                desc: item.desc || 'DETAIL_' + String(i).padStart(2, '0'),
                meta: item.meta || 'RAW // 24MP'
            };
        }
    });
    this.atlasFlight = opts.flight || null;
    if (opts.flight && opts.flight.src && this.detailImages[0]) this.detailImages[0].url = opts.flight.src;
    this.switchView('project_detail');
    const slug = this.slugOf(project);
    const url = '/projects/' + slug + '/';
    if (opts.push !== false && location.pathname !== url) history.pushState(opts.fromMap ? { atlasProject: slug, project: slug } : { project: slug }, '', url);
    if (opts.flight) this.$nextTick(() => this.playAtlasFlightIn());
    document.title = String(Alpine.store('lang').name(project) || '').replace(/_/g, ' ') + ' | ' + HOME_TITLE;
},
                copyProjectLink() {
                    const project = this.selectedProject;
                    if (!project) return;
                    const url = location.origin + '/projects/' + this.slugOf(project) + '/';
                    const mark = () => {
                        this.linkCopied = true;
                        clearTimeout(this._copyTimer);
                        this._copyTimer = setTimeout(() => { this.linkCopied = false; }, 1600);
                    };
                    const fallback = () => {
                        const field = document.createElement('textarea');
                        field.value = url;
                        field.setAttribute('readonly', '');
                        field.style.position = 'fixed';
                        field.style.left = '-9999px';
                        document.body.appendChild(field);
                        field.select();
                        try { document.execCommand('copy'); mark(); } catch (err) {}
                        document.body.removeChild(field);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(url).then(mark).catch(fallback);
                    } else {
                        fallback();
                    }
                },
              selectDetailImage(index) {
    this.currentDetailImageIndex = index;
},
prevDetailImage() {
    if (this.detailImages.length === 0) return;
    if (this.currentDetailImageIndex > 0) {
        this.currentDetailImageIndex--;
    }
},
nextDetailImage() {
    if (this.detailImages.length === 0) return;
    if (this.currentDetailImageIndex < this.detailImages.length - 1) {
        this.currentDetailImageIndex++;
    }
},
getSliderOffset() {
    const baseOffset = -this.currentDetailImageIndex * 100;
    if (this.isDragging && this.containerWidth > 0) {
        const dragOffset = ((this.touchCurrentX - this.touchStartX) / this.containerWidth) * 100;
        return baseOffset + dragOffset;
    }
    return baseOffset;
},
handleThumbnailWheel(e) {
    e.preventDefault();
    e.currentTarget.scrollLeft += e.deltaY;
},
handleSwipeStart(e) {
    if (this.isAnimating) return;
    this.isDragging = true;
    this.touchStartX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
    this.offsetX = 0;
},
handleSwipeMove(e) {
    if (!this.isDragging) return;
    const currentX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
    this.offsetX = currentX - this.touchStartX;
},
handleSwipeEnd() {
    if (!this.isDragging) return;
    this.isDragging = false;
    this.isAnimating = true;
    
    const threshold = 80;
    if (this.offsetX < -threshold && this.currentDetailImageIndex < this.detailImages.length - 1) {
        this.currentDetailImageIndex++;
    } else if (this.offsetX > threshold && this.currentDetailImageIndex > 0) {
        this.currentDetailImageIndex--;
    }
    
    this.offsetX = 0;
    setTimeout(() => { this.isAnimating = false; }, 300);
},
getPrevIndex() {
    return this.currentDetailImageIndex > 0 ? this.currentDetailImageIndex - 1 : null;
},
getNextIndex() {
    return this.currentDetailImageIndex < this.detailImages.length - 1 ? this.currentDetailImageIndex + 1 : null;
},
                get filteredProjects() {
    return this.projects.filter((project) => {
        if (project.discipline !== this.worksEntry) return false;
        if (!this.worksType || this.worksType === 'all') return true;
        return project.type === this.worksType;
    });
},
                get worksTypeOptions() {
                    const order = ['office', 'commercial', 'residential', 'cultural', 'education', 'sports', 'exhibition', 'public', 'hospitality', 'mixed_use'];
                    const inEntry = this.projects.filter((project) => project.discipline === this.worksEntry);
                    if (!inEntry.length) return [];
                    const counts = {};
                    inEntry.forEach((project) => {
                        if (!project.type) return;
                        counts[project.type] = (counts[project.type] || 0) + 1;
                    });
                    const keys = Object.keys(counts).sort((a, b) => {
                        const ia = order.indexOf(a);
                        const ib = order.indexOf(b);
                        return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
                    });
                    return [{ key: 'all', count: inEntry.length }].concat(keys.map((key) => ({ key, count: counts[key] })));
                },
openFilm(film) {
    this.selectedFilm = film;
    this.switchView('film_detail');
},
closeFilm() {
    this.selectedFilm = null;
    this.switchView('film');
},
get filteredFilmProjects() {
    if (this.activeFilmFilter === 'ALL') return this.filmProjects;
    return this.filmProjects.filter(p => p.category === this.activeFilmFilter);
}
            }));
        });
    </script>
