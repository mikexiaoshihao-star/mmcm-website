                'J&A': 'J&A',
                'gad': 'gad',
                'SewDesign': '纫合设计',
                'Jin_FX': 'Jin FX'
            };
            const LOCATION_ZH = {
                'Luzhou_Sichuan': '四川泸州',
                'Chengdu_Sichuan': '四川成都',
                'Chengdu,Sichuan': '四川成都',
                'Chengdu, Sichuan': '四川成都',
                'Zigong_Sichuan': '四川自贡',
                'Yibin_Sichuan': '四川宜宾',
                "Xi'an_Shaanxi": '陕西省 西安市',
                "Xi'an,Shaanxi": '陕西省 西安市',
                "Xi'an, Shaanxi": '陕西省 西安市',
                'Shenzhen_Guangdong': '广东深圳',
                'Shenzhen,Guangdong': '广东深圳',
                'Shenzhen, Guangdong': '广东深圳',
                'Ningbo_Zhejiang': '浙江宁波',
                'Yiwu_Zhejiang': '浙江省 义乌市',
                'Xichang_Sichuan': '四川西昌',
                'Xichang, Sichuan': '四川西昌',
                'Yunyang_Chongqing': '重庆云阳',
                'Yunyang': '重庆云阳',
                'Guangyang_Bay,Chongqing': '重庆广阳湾',
                'Guangyang Bay, Chongqing': '重庆广阳湾',
                'Chongqing': '重庆',
                'Shanghai': '上海',
                'Beijing': '北京',
                'Wuhan': '湖北武汉',
                'Wuhan,Hubei': '湖北武汉',
                'CHENGDU / SICHUAN': '四川成都'
            };
            const UI = {
                en: {
                    navWorks: 'WORKS', navFilm: 'FILM', navMedia: 'MEDIA', navStudio: 'STUDIO', navContact: 'CONTACT',
                    navMenu: 'MENU', navClose: 'CLOSE',
                    architecture: 'Architecture', interior: 'Interior', landscape: 'Landscape',
                    comingSoon: 'Projects coming soon.', allFilms: 'ALL_FILMS',
                    filterAll: 'All', filterBy: 'Filter by type',
                    type_office: 'Office', type_commercial: 'Commercial', type_residential: 'Residential',
                    type_cultural: 'Cultural', type_education: 'Education', type_sports: 'Sports',
                    type_exhibition: 'Exhibition', type_public: 'Public', type_hospitality: 'Hospitality',
                    type_mixed_use: 'Mixed-use',
                    projectDetail: 'Project Detail',
                    returnGrid: 'RETURN TO GRID', filmPlayer: 'Film Player',
                    videoUnsupported: '您的浏览器不支持视频播放',
                    interview: 'INTERVIEW', photographer: '01 // PHOTOGRAPHER', theStudio: '02 // THE STUDIO', client: '03 // CLIENT',
                    mobile: 'Mobile / Wechat', email: 'Email Address', site: 'Official Site', social: '02 // SOCIAL_MATRIX',
                    location: 'LOCATION_DATA', linkArrow: '>> LINK',
                    architect: 'ARCHITECT', year: 'YEAR', type: 'TYPE', discipline: 'DISCIPLINE', coordinates: 'COORDINATES', images: 'IMAGES', locField: 'LOCATION',
                    returnMap: 'RETURN TO MAP',
                    mediaPage: 'Media', typeWechat: 'WECHAT', typeMagazine: 'MAGAZINE', typeFirm: 'FIRM', typeAward: 'AWARD', typeWebsite: 'WEBSITE'
                },
                zh: {
                    navWorks: '作品', navFilm: '影片', navMedia: '媒体', navStudio: '工作室', navContact: '联系',
                    navMenu: '菜单', navClose: '关闭',
                    architecture: '建筑', interior: '室内', landscape: '景观',
                    comingSoon: '作品上传中', allFilms: '全部影片',
                    filterAll: '全部', filterBy: '按类型筛选',
                    type_office: '办公', type_commercial: '商业', type_residential: '住宅',
                    type_cultural: '文化', type_education: '教育', type_sports: '体育',
                    type_exhibition: '展览', type_public: '公共', type_hospitality: '酒店',
                    type_mixed_use: '综合体',
                    projectDetail: '项目',
                    returnGrid: '返回列表', filmPlayer: '影片',
                    videoUnsupported: '您的浏览器不支持视频播放',
                    interview: '专访', photographer: '01 // 摄影师', theStudio: '02 // 工作室', client: '03 // 客户',
                    mobile: '手机/微信', email: '电子邮箱', site: '官方网站', social: '02 // 社交',
                    location: '所在地', linkArrow: '>> 链接',
                    architect: '建筑设计', year: '年份', type: '类型', discipline: '门类', coordinates: '坐标', images: '图片', locField: '地点',
                    returnMap: '返回地图',
                    mediaPage: '媒体', typeWechat: '公众号', typeMagazine: '杂志', typeFirm: '设计公司', typeAward: '奖项', typeWebsite: '网站'
                }
            };
            Alpine.store('lang', {
                code: window.__MMCM_LANG === 'zh' ? 'zh' : 'en',
                t(key) { return (UI[this.code] && UI[this.code][key]) || UI.en[key] || key; },
                plain(text) {
                    return String(text == null ? '' : text).replace(/_/g, ' ');
                },
                name(item) {
                    if (!item) return '';
                    if (this.code === 'zh' && item.title_zh) return item.title_zh;
                    const en = item.title_en || item.title || '';
                    return this.plain(en);
                },
                personName(studio) {
                    if (!studio) return '';
                    if (this.code === 'zh' && studio.name_zh) return studio.name_zh;
                    return studio.name || '';
                },
                personTitle(studio) {
                    if (!studio) return '';
                    if (this.code === 'zh' && studio.title_zh) return studio.title_zh;
                    return studio.title || '';
                },
                architect(item) {
                    if (!item) return '';
                    const en = item.architect || item.name || '';
                    if (this.code !== 'zh') return this.plain(en);
                    if (item.architect_zh) return item.architect_zh;
                    return ARCHITECT_ZH[en] || this.plain(en);
                },
                place(value) {
                    const en = value == null ? '' : String(value);
                    if (this.code === 'zh') return LOCATION_ZH[en] || this.plain(en);
                    const parts = en.split('_').filter(Boolean);
                    if (parts.length >= 2) return parts[0] + ', ' + parts.slice(1).join(' ');
                    return en;
                },
                set(code) {
                    if (code !== 'zh' && code !== 'en') return;
                    this.code = code;
                    try { localStorage.setItem('mmcm-lang', code); } catch (e) {}
                    document.documentElement.lang = code === 'zh' ? 'zh-CN' : 'en';
                    if (code === 'zh' && window.__MMCM_LOAD_ZH_FONT) window.__MMCM_LOAD_ZH_FONT();
                }
            });
            const HOME_TITLE = 'MMCM STUDIO 毫厘建筑摄影';

            Alpine.data('mainApp', () => ({
                currentView: (/^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash) || (window.__INITIAL_PROJECT__ && /^\/projects\//.test(location.pathname))) ? 'project_detail' : ((/^\/media\/?$/.test(location.pathname) || /^#\/media\/?$/.test(location.hash) || (window.__INITIAL_VIEW__ === 'media' && /^\/media\/?$/.test(location.pathname))) ? 'media' : (/^#\/film\/?$/.test(location.hash) ? 'film' : (new URLSearchParams(location.search).get('view') === 'map' ? 'works' : 'home'))),
                /* 'from-map': the info column is only used when a project is opened from ATLAS. 'always': every project page uses it. */
                atlasProjectLayout: 'always',
                worksView: new URLSearchParams(location.search).get('view') === 'map' ? 'map' : 'grid',
                openedFromMap: false,
                worksEntry: 'architecture',
                worksType: 'all',
                worksFilterOpen: false,
                filmFilterOpen: false,
                menuOpen: false,
                activeFilmFilter: (function () {
                    if (!/^#\/film\/?$/.test(location.hash)) return 'ALL';
                    const raw = new URLSearchParams(location.search).get('type');
                    const key = String(raw || '').trim().toLowerCase();
                    if (!key || key === 'all') return 'ALL';
                    const cat = (siteData.filmCategories || []).find((item) => String(item.key).toLowerCase() === key);
                    return cat ? cat.key : 'ALL';
                })(),
                currentHomeIndex: 0,
                homeImgVisible: true,
                categories: siteData.categories,
               homeProjects: siteData.homeProjects,
homeProjectsMobile: siteData.homeProjectsMobile || siteData.homeProjects,
currentHomeMobileIndex: 0,
                projects: siteData.projects,
                filmProjects: siteData.filmProjects || [],
                filmCategories: siteData.filmCategories || [],
                studio: siteData.studio,
                contact: siteData.contact,
                mediaItems: siteData.media || [],
                selectedProject: null,
                selectedFilm: null,
                detailImages: [],
                currentDetailImageIndex: 0,
                touchStartX: 0,
                touchCurrentX: 0,
                isDragging: false,
                containerWidth: 0,
               
                get currentHomeProject() { return this.homeProjects[this.currentHomeIndex]; },
                nextHomeProject() {
    this.homeImgVisible = false;
    setTimeout(() => {
        this.currentHomeIndex = (this.currentHomeIndex + 1) % this.homeProjects.length;
        this.currentHomeMobileIndex = (this.currentHomeMobileIndex + 1) % this.homeProjectsMobile.length;
        this.homeImgVisible = true;
    }, 400);
},
get currentHomeMobileProject() { return this.homeProjectsMobile[this.currentHomeMobileIndex]; },
                slugOf(project) {
                    if (!project) return '';
                    if (project.slug) return project.slug;
                    return String(project.title || '').replace(/&/g, 'and').replace(/[^A-Za-z0-9]+/g, '-').replace(/^-+|-+$/g, '').toLowerCase();
                },
                findBySlug(slug) {
                    if (!slug) return null;
                    return this.projects.find((project) => this.slugOf(project) === slug) || null;
                },
                onMediaUrl() {
                    return /^\/media\/?$/.test(location.pathname) || /^#\/media\/?$/.test(location.hash);
                },
                onFilmUrl() {
                    return /^#\/film\/?$/.test(location.hash);
                },
                routeFromUrl() {
                    const pathMatch = location.pathname.match(/^\/projects\/([^/]+)\/?$/);
                    const hashMatch = location.hash.match(/^#\/project\/([^/?]+)/);
                    let slug = null;
                    if (pathMatch) slug = decodeURIComponent(pathMatch[1]);
                    else if (hashMatch) slug = decodeURIComponent(hashMatch[1]);
                    else if (window.__INITIAL_PROJECT__ && /^\/projects\//.test(location.pathname)) slug = window.__INITIAL_PROJECT__;
                    const project = slug ? this.findBySlug(slug) : null;
                    if (project) {
                        this.openProject(project, { push: false, fromMap: !!(history.state && history.state.atlasProject) });
                        this.applyTypeFromUrl();
                        return;
                    }
                    if (this.onMediaUrl()) {
                        this.currentView = 'media';
                        document.title = Alpine.store('lang').t('mediaPage') + ' | ' + HOME_TITLE;
                        this.applyTypeFromUrl();
                        return;
                    }
                    if (this.onFilmUrl()) {
                        if (this.currentView === 'project_detail') {
                            this.selectedProject = null;
                            this.detailImages = [];
                            this.currentDetailImageIndex = 0;
                        }
                        this.selectedFilm = null;
                        this.applyFilmFromUrl();
                        return;
                    }
                    if (this.currentView === 'film' || this.currentView === 'film_detail') {
                        this.selectedFilm = null;
                        this.filmFilterOpen = false;
                        this.activeFilmFilter = 'ALL';
                        this.currentView = 'home';
                        document.title = HOME_TITLE;
                    }
                    if (this.currentView === 'project_detail') {
                        this.selectedProject = null;
                        this.detailImages = [];
                        this.currentDetailImageIndex = 0;
                        this.openedFromMap = false;
                        this.currentView = 'works';
                        document.title = HOME_TITLE;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    } else if (this.currentView === 'media') {
                        this.currentView = 'home';
                        document.title = HOME_TITLE;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                    if (this.applyTypeFromUrl()) document.title = HOME_TITLE;
                    this.applyViewFromUrl();
                    const params = new URLSearchParams(location.search);
                    const bareHome = !this.onMediaUrl() && !this.onFilmUrl() && !/^\/projects\//.test(location.pathname) && params.get('view') !== 'map' && !params.get('type') && !location.hash;
                    if (bareHome) {
                        this.currentView = 'home';
                        document.title = HOME_TITLE;
                        if (window.MMCM_ATLAS && window.MMCM_ATLAS.hide) window.MMCM_ATLAS.hide();
                    }
                },
                init() {
                    this.routeFromUrl();
                    window.addEventListener('popstate', () => this.routeFromUrl());
                    window.addEventListener('hashchange', () => this.routeFromUrl());
                    window.addEventListener('resize', () => { this.closeWorksFilter(false); this.closeFilmFilter(false); });
                    window.addEventListener('keydown', (e) => {
                        this.onWorksFilterKey(e);
                        this.onFilmFilterKey(e);
                        if (e.key === 'Escape' && this.menuOpen) {
                            this.menuOpen = false;
                            const btn = this.$root.querySelector('.menu-btn');
                            if (btn) btn.focus();
                        }
                    });
                    const menuMq = window.matchMedia('(min-width: 832px)');
                    const closeMenuIfWide = () => { if (menuMq.matches) this.menuOpen = false; };
                    if (menuMq.addEventListener) menuMq.addEventListener('change', closeMenuIfWide);
                    else menuMq.addListener(closeMenuIfWide);
                    this.$nextTick(() => document.documentElement.classList.remove('route-project'));
                },
                pushAppUrl(dest, view) {
                    const cur = location.pathname + location.search + location.hash;
                    if (dest !== cur) history.pushState({ view: view }, '', dest);
                },
                worksQuery(url) {
                    if (this.worksView === 'map') url.searchParams.set('view', 'map');
                    else url.searchParams.delete('view');
                    if (!this.worksType || this.worksType === 'all') url.searchParams.delete('type');
                    else url.searchParams.set('type', this.worksType);
                    return url;
                },
                worksUrl() {
                    const next = this.worksQuery(new URL('/', location.origin));
                    return next.pathname + next.search + next.hash;
                },
                switchView(view) {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    const atlasOpen = !!(window.MMCM_ATLAS && window.MMCM_ATLAS.pageOpen && window.MMCM_ATLAS.pageOpen());
                    if (atlasOpen) window.MMCM_ATLAS.closePage();
                    const leavingProject = this.currentView === 'project_detail' && view !== 'project_detail';
                    const leavingMedia = this.currentView === 'media' && view !== 'media';
                    const leavingFilm = (this.currentView === 'film' || this.currentView === 'film_detail') && view !== 'film' && view !== 'film_detail';
                    const enteringFilm = (view === 'film' || view === 'film_detail') && !this.onFilmUrl();
                    this.currentView = view;
                    const onProjectUrl = /^\/projects\/[^/]+\/?$/.test(location.pathname) || /^#\/project\/[^/?]+/.test(location.hash);
                    if (view === 'home') {
                        this.pushAppUrl('/', 'home');
                    } else if (view === 'works') {
                        this.pushAppUrl(this.worksUrl(), 'works');
                    } else if ((leavingProject && onProjectUrl) || (atlasOpen && onProjectUrl) || (leavingMedia && this.onMediaUrl()) || (leavingFilm && this.onFilmUrl()) || enteringFilm) {
                        const next = new URL('/', location.origin);
                        if (view === 'film' || view === 'film_detail') {
                            next.hash = '/film';
                            if (this.activeFilmFilter && this.activeFilmFilter !== 'ALL') next.searchParams.set('type', this.filmSlug(this.activeFilmFilter));
                        }
                        this.pushAppUrl(next.pathname + next.search + next.hash, view);
                    }
                    if (view === 'home' || leavingProject || leavingMedia) document.title = HOME_TITLE;
                },
                openMedia() {
                    const leavingProject = this.currentView === 'project_detail';
                    this.currentView = 'media';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    if (leavingProject) {
                        this.selectedProject = null;
                        this.detailImages = [];
                        this.currentDetailImageIndex = 0;
                    }
                    document.title = Alpine.store('lang').t('mediaPage') + ' | ' + HOME_TITLE;
                    if (!/^\/media\/?$/.test(location.pathname)) history.pushState({ view: 'media' }, '', '/media/');
                },
                mediaCover(cover) {
                    if (!cover) return '';
                    const file = String(cover).split('/').pop();
                    return '/images/media/' + file;
                },
                mediaTypeLabel(type) {
                    const raw = String(type || '').trim();
                    const value = raw.toLowerCase();
                    const t = Alpine.store('lang').t.bind(Alpine.store('lang'));
                    if (raw.includes('公众号')) return t('typeWechat');
                    if (value === 'magazine' || raw.includes('杂志')) return t('typeMagazine');
                    if (value.includes('firm') || raw.includes('设计公司')) return t('typeFirm');
                    if (value.includes('award') || raw.includes('奖项')) return t('typeAward');
                    if (value === 'website' || value === 'media' || raw.includes('网站')) return t('typeWebsite');
                    return raw;
                },
                categoryLabel(key) {
                    const zh = Alpine.store('lang').code === 'zh';
                    const cat = (this.categories || []).concat(this.filmCategories || []).find((item) => item.key === key);
                    if (!cat) return key || '';
                    return zh ? cat.name : cat.key;
                },
                applyDocumentTitle() {
                    const lang = Alpine.store('lang');
                    if (this.currentView === 'project_detail' && this.selectedProject) {
                        document.title = String(lang.name(this.selectedProject) || '').replace(/_/g, ' ') + ' | ' + HOME_TITLE;
                    } else if (this.currentView === 'media') {
                        document.title = lang.t('mediaPage') + ' | ' + HOME_TITLE;
                    } else {
                        document.title = HOME_TITLE;
                    }
                },
                mediaSortKey(item) {
                    if (item && item.date) return String(item.date);
                    if (item && item.year) return String(item.year).padStart(4, '0') + '-00-00';
                    return '';
                },
                mediaCleanLabel(text) {
                    return String(text || '')
                        .replace(/（[^）]*不在site\.json[^）]*）/g, '')
                        .replace(/\([^)]*不在site\.json[^)]*\)/g, '')
                        .replace(/\([^)]*个人摄影[^)]*\)/g, '')
                        .trim();
                },
                mediaGroupKey(item) {
                    const byTitle = {
                        'OPPO_Technology_&_Research_Center_Tower': 'OPPO科技研究中心大厦',
                        'Chengdu_SKP': '成都SKP',
                        'LuxeLakes_Kindergarten_(North_Campus)': '四川天府新区麓湖幼儿园（北区）',
