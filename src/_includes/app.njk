    <!-- VIEW 2.5: PROJECT DETAIL -->
    <section x-show="currentView === 'project_detail'" x-cloak class="project-sheet fixed left-0 right-0 bottom-0 top-16 md:top-20 z-[60] bg-white" :class="projectUsesInfoColumn ? 'is-info' : 'is-classic'">
        <div class="project-stage relative w-full bg-[#f4f4f4] overflow-hidden flex items-center justify-center group">
            <button @click.stop="prevDetailImage()" class="sheet-arrow absolute left-2 md:left-8 z-30 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center text-[#111111] bg-white/90 hover:bg-white border border-black/10 focus:outline-none transition-colors">‹</button>
         <div class="relative w-full h-full overflow-hidden select-none"
     @touchstart="handleSwipeStart($event)"
     @touchmove.prevent="handleSwipeMove($event)"
     @touchend="handleSwipeEnd()"
     @mousedown="handleSwipeStart($event)"
     @mousemove="handleSwipeMove($event)"
     @mouseup="handleSwipeEnd()"
     @mouseleave="handleSwipeEnd()">
    <div class="flex h-full"
         :class="isDragging ? '' : 'transition-transform duration-300 ease-out'"
