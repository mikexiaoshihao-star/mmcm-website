    <script>
        /* Pin the visible edges of 毫 and 影 to the wordmark. Side bearings differ by face, so measure the face that actually loaded. */
        (function () {
            var line = document.querySelector('.site-logo-zh');
            if (!line) return;
            var first = line.firstElementChild;
            var last = line.lastElementChild;
            function bearing(ch) {
                var cs = getComputedStyle(line);
                var size = 200;
                var canvas = document.createElement('canvas');
                var ctx = canvas.getContext('2d');
                if (!ctx || !ctx.measureText) return null;
                ctx.font = cs.fontWeight + ' ' + size + 'px ' + cs.fontFamily;
                var metrics = ctx.measureText(ch);
                if (metrics.actualBoundingBoxLeft == null || metrics.actualBoundingBoxRight == null) return null;
                return {
                    left: -metrics.actualBoundingBoxLeft / size,
                    right: (metrics.width - metrics.actualBoundingBoxRight) / size
                };
            }
            function align() {
                var start = bearing(first.textContent);
                var end = bearing(last.textContent);
                if (!start || !end) return;
                first.style.marginLeft = (-start.left) + 'em';
                last.style.marginRight = (-end.right) + 'em';
            }
            if (document.fonts && document.fonts.ready) document.fonts.ready.then(align);
            else align();
        })();
    </script>
